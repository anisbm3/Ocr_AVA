# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# LM Studio Configuration (for Qwen Vision)
# If running LM Studio on Windows host from WSL, use host.docker.internal or Windows IP
# For WSL without Docker: use $(cat /etc/resolv.conf | grep nameserver | awk '{print $2}')
LM_STUDIO_HOST=http://host.docker.internal:1234
# Alternative for direct WSL: LM_STUDIO_HOST=http://172.X.X.X:1234 (your Windows host IP)

# Qwen Model Configuration
QWEN_MODEL=qwen2.5-vl-7b

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=7861
DEBUG=true

# CV Template Path
CV_TEMPLATE_PATH=./cv_template_camelCase.json